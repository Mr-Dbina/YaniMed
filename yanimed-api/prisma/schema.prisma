generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // Supabase pooler (port 6543) for runtime
  directUrl = env("DIRECT_URL")    // Supabase direct connection (port 5432) for migrations
}

enum DocumentStatus {
  QUEUED
  PROCESSING // extraction / OCR / chunking / embedding in progress
  READY
  FAILED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
}

enum SubjectStatus {
  ACTIVE
  DELETING
}

enum DeletionStage {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ExtractionMethod {
  TEXT    // pdfjs-dist text layer
  OCR     // Tesseract.js fallback
  HYBRID  // text layer plus OCR
}

enum UploadAttemptStatus {
  PENDING
  UPLOADING
  AWAITING_RETRY
  CLEANUP_PENDING
  UPLOADED
}

enum MessageRole {
  USER
  ASSISTANT
}

// How an ASSISTANT message was produced
enum AnswerMode {
  GENERATED      // OmniRoute model answered from retrieved chunks
  RETRIEVAL_ONLY // all free providers failed -> raw passages shown
  NOT_FOUND      // no supporting evidence in the uploaded PDFs
}

enum GenerationJobState {
  QUEUED
  RUNNING
  STALLED
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum MockQuestionStatus {
  ACTIVE
  QUARANTINED
  RETIRED
  SOURCE_UNAVAILABLE
}

enum MockAttemptStatus {
  GENERATING
  READY
  IN_PROGRESS
  AWAITING_SUBMISSION
  COMPLETED
  FAILED
  CANCELLED
  ABANDONED
}

enum AttemptQuestionStatus {
  UNSEEN
  SKIPPED
  ANSWERED
}

enum QuestionReportReason {
  ANSWER_KEY
  AMBIGUITY
  CITATION
  EXPLANATION
  OTHER
}

enum QuestionReportStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

enum AiCallPurpose {
  PLAN
  DRAFT
  VERIFY
  EMBED
}

model Subject {
  id           String        @id @default(uuid())
  name         String
  status       SubjectStatus @default(ACTIVE)
  deletedAt    DateTime?
  instructions String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  documents    Document[]
  chats        Chat[]
  initialUpload UploadAttempt?
  deletionJobs DeletionJob[]

  subjectTopics  SubjectTopic[]
  generationJobs GenerationJob[]
  mockQuestions  MockQuestion[]
  mockAttempts   MockAttempt[]

  @@unique([name])
}

model PdfObject {
  id        String     @id @default(uuid())
  sha256    String     @unique
  r2Key     String     @unique
  sizeBytes Int
  createdAt DateTime   @default(now())

  documents Document[]
}

model Document {
  id           String         @id @default(uuid())
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  pdfObjectId  String?
  pdfObject    PdfObject?     @relation(fields: [pdfObjectId], references: [id], onDelete: SetNull)

  title        String
  fileUrl      String         // R2 object key
  fileSize     Int
  pageCount    Int?
  status       DocumentStatus @default(QUEUED)
  errorMessage String?

  // resumable background processing
  processedPages Int            @default(0) // last page fully extracted+chunked
  embeddedChunks Int            @default(0)
  ocrPages       Int            @default(0)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  chunks         Chunk[]
  pages          DocumentPage[]
  citations      MessageCitation[]
  initialUpload  UploadAttempt?
  processingJobs ProcessingJob[]

  generationJobDocuments GenerationJobDocument[]
  questionCitations      QuestionCitation[]

  @@unique([subjectId, pdfObjectId])
  @@index([subjectId])
  @@index([status])
}

model ProcessingJob {
  id           String              @id @default(uuid())
  documentId   String
  document     Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  status       ProcessingJobStatus @default(QUEUED)
  attempt      Int                 @default(0)
  maxAttempts  Int                 @default(4)
  nextRunAt    DateTime            @default(now())

  leaseOwner   String?
  leaseUntil   DateTime?
  fencingToken Int                 @default(0)

  errorCode    String?
  errorMessage String?

  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, nextRunAt])
  @@index([documentId])
}

model Chunk {
  id               String           @id @default(uuid())
  documentId       String
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content          String
  page             Int              // original PDF page, set at extraction time
  chapterGuess     String?
  chapterConfirmed String?
  chunkIndex       Int

  extractionMethod ExtractionMethod @default(TEXT)
  needsReview      Boolean          @default(false) // poor OCR / low-quality text flag

  embeddingModel   String?          // e.g. "gemini-embedding-001@768"; null = not embedded yet

  // Added/managed outside Prisma's type system. Read/write via $queryRaw.
  //
  // NOTE: Prisma cannot model indexes on Unsupported() columns, so it will
  // always report chunk_embedding_idx / chunk_tsv_idx as droppable drift.
  // The indexes are created by 20261010120000_align_schema_and_pgvector.
  // => Apply migrations with `npm run db:migrate` (migrate deploy) only.
  //    NEVER `prisma migrate dev`, it would silently drop hybrid-search indexes.
  embedding        Unsupported("vector(768)")?
  tsv              Unsupported("tsvector")?

  createdAt        DateTime         @default(now())

  citations        MessageCitation[]

  @@unique([documentId, chunkIndex]) // idempotent re-processing on resume
  @@index([documentId])
  @@index([documentId, page])
}

model DocumentPage {
  id               String           @id @default(uuid())
  documentId       String
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  pageNumber       Int              // exact 1-based physical PDF page number
  text             String
  charCount        Int              @default(0)

  extractionMethod ExtractionMethod @default(TEXT)
  needsOcr         Boolean          @default(false)
  ocrUsed          Boolean          @default(false)
  ocrError         String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([documentId, pageNumber])
}

// Durable intent/receipt. A reserved Subject remains incomplete; this record
// never indicates PDF processing readiness. External I/O occurs outside DB transactions.
model UploadAttempt {
  id             String              @id @default(uuid())
  idempotencyKey String              @unique
  requestHash    String
  subjectId      String              @unique
  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  documentId     String?             @unique
  document       Document?           @relation(fields: [documentId], references: [id], onDelete: Restrict)
  objectKey      String              @unique
  filename       String
  fileSize       Int
  fileSha256     String
  pageCount      Int
  status         UploadAttemptStatus @default(PENDING)
  etag           String?
  lastError      String?
  leaseOwner     String?
  leaseUntil     DateTime?
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
}

model DeletionJob {
  id          String        @id @default(uuid())
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  stage       DeletionStage @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([subjectId])
  @@index([stage])
}

model Chat {
  id         String    @id @default(uuid())
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages   Message[]

  @@index([subjectId])
}

model Message {
  id         String      @id @default(uuid())
  chatId     String
  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role       MessageRole
  content    String
  edited     Boolean     @default(false)

  // ASSISTANT-only
  answerMode AnswerMode?
  provider   String?     // which OmniRoute provider answered
  model      String?     // which model answered

  rating     Int?        // 1 / -1 / null

  createdAt  DateTime    @default(now())

  citations  MessageCitation[]

  @@index([chatId])
}

// Backend-verified citations (document + page checked against retrieved chunks)
model MessageCitation {
  id         String    @id @default(uuid())
  messageId  String
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkId    String?
  chunk      Chunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  page       Int       // snapshot, survives chunk re-processing
  chapter    String?   // snapshot of chapterConfirmed ?? chapterGuess

  @@index([messageId])
  @@index([documentId, page])
}

// ---------------------------------------------------------------------------
// Mock Test v2.1 (single user, scoped by subjectId; no userId)
// ---------------------------------------------------------------------------

model SubjectTopic {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  createdAt DateTime @default(now())

  questions MockQuestion[]

  @@unique([subjectId, key])
  @@index([subjectId])
}

model GenerationJob {
  id             String             @id @default(uuid())
  subjectId      String
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  state          GenerationJobState
  requestedCount Int                @default(25)
  acceptedCount  Int                @default(0)
  planJson       Json?
  heartbeatAt    DateTime?
  recoveryCount  Int                @default(0)
  aiCallCount    Int                @default(0)
  failureReason  String?
  idempotencyKey String             @unique
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())

  documents GenerationJobDocument[]
  questions MockQuestion[]
  attempts  MockAttempt[]
  aiCalls   AiCallLog[]

  @@index([subjectId])
}

// Snapshot of the READY documents a generation job was planned from.
model GenerationJobDocument {
  jobId      String
  job        GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentId String
  // NO ACTION is checked at statement end, so a whole-Subject cascade can finish.
  document   Document      @relation(fields: [documentId], references: [id], onDelete: NoAction)
  createdAt  DateTime      @default(now())

  @@id([jobId, documentId])
  @@index([documentId])
}

model MockQuestion {
  id                   String             @id @default(uuid())
  subjectId            String
  subject              Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId              String
  topic                SubjectTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  jobId                String?
  job                  GenerationJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status               MockQuestionStatus @default(ACTIVE)
  stem                 String
  leadIn               String?
  educationalObjective String
  draftModel           String
  verifierModel        String?
  promptVersion        String
  validatorVersion     String
  verifierResult       Json?
  createdAt            DateTime           @default(now())

  choices          MockChoice[]
  citations        QuestionCitation[]
  attemptQuestions AttemptQuestion[]
  reports          QuestionReport[]

  @@index([subjectId])
  @@index([topicId])
  @@index([jobId])
  @@index([status])
}

model MockChoice {
  id          String       @id @default(uuid())
  questionId  String
  question    MockQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position    Int
  text        String
  isCorrect   Boolean
  explanation String
  createdAt   DateTime     @default(now())

  attemptAnswers AttemptAnswer[]

  @@unique([questionId, position])
}

model QuestionCitation {
  id                    String       @id @default(uuid())
  questionId            String
  question              MockQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  documentId            String?
  document              Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentTitleSnapshot String
  pageNumber            Int
  printedPage           String?
  quote                 String
  createdAt             DateTime     @default(now())

  @@index([questionId])
  @@index([documentId])
}

model MockAttempt {
  id             String            @id @default(uuid())
  subjectId      String
  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status         MockAttemptStatus
  sessionVersion Int               @default(1)
  cursorPosition Int               @default(1)
  lastActivityAt DateTime          @default(now())
  jobId          String?
  job            GenerationJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  attemptQuestions AttemptQuestion[]
  result           AttemptResult?
  reports          QuestionReport[]

  @@index([subjectId])
  @@index([status])
  @@index([jobId])
}

model AttemptQuestion {
  id          String                @id @default(uuid())
  attemptId   String
  attempt     MockAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    MockQuestion          @relation(fields: [questionId], references: [id], onDelete: NoAction)
  position    Int
  choiceOrder Int[]
  status      AttemptQuestionStatus @default(UNSEEN)
  createdAt   DateTime              @default(now())

  answer AttemptAnswer?

  @@unique([attemptId, position])
  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AttemptAnswer {
  id                String          @id @default(uuid())
  attemptQuestionId String          @unique
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  choiceId          String
  choice            MockChoice      @relation(fields: [choiceId], references: [id], onDelete: NoAction)
  revision          Int             @default(1)
  idempotencyKey    String
  createdAt         DateTime        @default(now())

  @@index([choiceId])
}

model AttemptResult {
  id        String      @id @default(uuid())
  attemptId String      @unique
  attempt   MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  snapshot  Json
  createdAt DateTime    @default(now())
}

model QuestionReport {
  id             String               @id @default(uuid())
  attemptId      String
  attempt        MockAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       MockQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reason         QuestionReportReason
  details        String?
  status         QuestionReportStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime             @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AiCallLog {
  id               String         @id @default(uuid())
  jobId            String?
  job              GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  purpose          AiCallPurpose
  model            String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  outcome          String
  errorCode        String?
  createdAt        DateTime       @default(now())

  @@index([jobId])
}
