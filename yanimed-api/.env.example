# --- Database (Supabase) -------------------------------------------------
# Runtime connection. Use the IPv4 pooler (session mode, port 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Migration connection. Supabase's direct host (db.PROJECT_REF.supabase.co)
# is IPv6-only and will not resolve on most home networks, so the pooler is
# used for both. NOTE: PgBouncer can swallow the _prisma_migrations ledger
# write. If a deploy reports success but `prisma migrate status` says the
# database is out of date, re-run: npx tsx scripts/seed-migration-ledger.ts
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- Cloudflare R2 (raw PDF storage) --------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""
R2_JURISDICTION=""

# --- Gemini (embeddings only; generation goes through OmniRoute) ----------
GEMINI_API_KEY=""

# --- OmniRoute (answer generation) ----------------------------------------
# Dashboard -> Endpoints for the key. Keep it in sync with this base URL.
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_API_KEY=""
OMNIROUTE_PRIMARY_MODEL="auto"
OMNIROUTE_FALLBACK_MODELS=""   # comma-separated, e.g. "model-a,model-b"

# --- ElevenLabs (speech-to-text / text-to-speech) ------------------------
# Backend-only. Prefer putting the real value in the git-ignored .env.local
# so it never lands in a commit.
ELEVENLABS_API_KEY=""

# --- Server ---------------------------------------------------------------
PORT=3000                      # Next.js dev server uses 3001
CORS_ORIGINS="http://localhost:3001"
